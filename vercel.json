{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"version": 2,
	"outputDirectory": "docs",
	"functions": {
		"api/*.js": {
			"maxDuration": 30
		}
	},
	"rewrites": [
		{
			"source": "/api/hub/:path*",
			"destination": "/api/hub"
		},
		{
			"source": "/api/dna",
			"destination": "/api/fashion"
		},
		{
			"source": "/api/dna/:path*",
			"destination": "/api/fashion"
		},
		{
			"source": "/api/fashion/:path*",
			"destination": "/api/fashion"
		},
		{
			"source": "/script-studio/login",
			"destination": "/script-studio/index.html"
		},
		{
			"source": "/script-studio/login/",
			"destination": "/script-studio/index.html"
		},
		{
			"source": "/script-studio/settings",
			"destination": "/script-studio/index.html"
		},
		{
			"source": "/script-studio/settings/",
			"destination": "/script-studio/index.html"
		},
		{
			"source": "/script-studio/p/:path*",
			"destination": "/script-studio/index.html"
		}
	]
}
