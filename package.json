{
  "name": "auto-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Auto video editor: upload a raw talking-head video, get a polished edit. Remotion rendering + ghost-editor editing logic.",
  "type": "module",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "studio": "remotion studio remotion/index.ts",
    "setup:whisper": "tsx server/setup-whisper.ts",
    "setup:library": "tsx server/fetch-library.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx server/selftest.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@remotion/bundler": "4.0.541",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/google-fonts": "4.0.541",
    "@remotion/install-whisper-cpp": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "@remotion/player": "^4.0.541",
    "@remotion/renderer": "4.0.541",
    "esbuild": "^0.24.2",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.541",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.7.2"
  }
}
